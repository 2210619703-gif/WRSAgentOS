# Runtime reads environment variables. This template is not auto-loaded.
# Loopback connect/nodes/wrs examples share generated local credentials by default.
# Optional override below: use the SAME value in each service/client run configuration.
# Leave empty for automatic example credentials; this is separate from LLM_API_KEY.
WRS_AGENT_TOKEN=

# ---- Planner model -------------------------------------------------------------------
# One set of variables for every vendor. LLM_PROTOCOL picks the wire format, not the
# vendor: most services speak one of these three.
#   openai_chat         POST {LLM_BASE_URL}/chat/completions  (GLM, DeepSeek, Qwen, Gemini,
#                       Moonshot, OpenRouter, vLLM, Ollama and other OpenAI-compatible APIs)
#   openai_responses    POST {LLM_BASE_URL}/responses         (OpenAI native; its reasoning models)
#   anthropic_messages  POST {LLM_BASE_URL}/v1/messages       (Claude native, and vendors'
#                       Claude-compatible endpoints)
LLM_PROTOCOL=openai_chat
# Required; no vendor is assumed. https only; plain http is accepted for loopback servers.
LLM_BASE_URL=
# Required: an actual model ID enabled on your account. The key and URL do not select one.
LLM_MODEL=qwen3.7-flash
# Sent as Bearer (openai_*) or x-api-key (anthropic_messages). May be empty only for a
# loopback server such as local vLLM/Ollama.
LLM_API_KEY=

# ---- Optional ------------------------------------------------------------------------
# none | minimal | low | medium | high | xhigh | max. Empty omits the field (vendor default).
# Passed unchanged into the protocol's own field: reasoning_effort (chat), reasoning.effort
# (responses), output_config.effort (anthropic; none there sends thinking.type=disabled).
# Which values a model accepts is the vendor's rule; an HTTP 400 usually means "not this one".
# Less reasoning answers faster and plans worse; Runtime still validates every plan.
LLM_REASONING_EFFORT=none
# auto (default) | required. Under auto some models write the plan as message text, which
# is always treated as an answer and never executed; required forces the propose_plan call
# (Chat explicitly selects that function; answers still arrive as kind=answer).
# GLM documents auto only; Anthropic rejects
# required while thinking is on.
LLM_TOOL_CHOICE=auto
# tools (default) | json_object | json_schema (JSON modes require openai_chat support).
# json_schema constrains the decision and each offered skill's declared parameters.
# Both JSON modes omit tools/tool_choice and still validate PlanDecision/Runtime locally.
# No automatic model switch, JSON repair or paid retry. TOOL_CHOICE is ignored in JSON modes.
LLM_OUTPUT_MODE=json_schema
# Verified local voice planning configuration (keep your own endpoint/key):
# LLM_MODEL=qwen3.8-flash
# LLM_OUTPUT_MODE=json_schema
# LLM_REASONING_EFFORT=
# LLM_EXTRA_BODY={"enable_thinking":false}
# Output cap, reasoning included (default 2048). Raise it for high effort.
LLM_MAX_TOKENS=
# Whole-request budget in seconds (default 20, at most 300).
LLM_TIMEOUT_S=
# JSON object merged into the request body for vendor-only switches. It may add fields but
# never replace ones the adapter sets (model, messages, tools, max tokens, effort...).
LLM_EXTRA_BODY=
# JSON object of extra headers, e.g. {"anthropic-beta":"..."}; cannot replace auth headers.
LLM_EXTRA_HEADERS=
# Explicit http(s) proxy. System/IDE HTTPS_PROXY variables are never used for model calls.
LLM_PROXY=

# ---- Endpoint examples (from vendor docs; not verified by this repository) -------------
# Zhipu GLM, Coding Plan (its terms restrict use to authorized scenarios; check yours):
#   LLM_PROTOCOL=openai_chat  LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# Zhipu GLM, standard API:
#   LLM_PROTOCOL=openai_chat  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   GLM-5.x thinks by default. The old GLM_THINKING=off is now
#   LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}; vendor docs say GLM-5.3 refuses it,
#   but glm-5.3-flash on the Coding Plan endpoint accepted it here, so test, then try low.
#   GLM_THINKING=low/high/max is now LLM_REASONING_EFFORT with the same value.
# Zhipu GLM, Claude-compatible:
#   LLM_PROTOCOL=anthropic_messages  LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# OpenAI:
#   LLM_PROTOCOL=openai_responses  LLM_BASE_URL=https://api.openai.com/v1
# Anthropic Claude:
#   LLM_PROTOCOL=anthropic_messages  LLM_BASE_URL=https://api.anthropic.com
#   Recent Claude models think adaptively by default; if replies end as incomplete
#   (stop_reason max_tokens), raise LLM_MAX_TOKENS (e.g. 8192) and LLM_TIMEOUT_S.
# DeepSeek:
#   LLM_PROTOCOL=openai_chat  LLM_BASE_URL=https://api.deepseek.com
# Alibaba Qwen (DashScope compatible mode):
#   LLM_PROTOCOL=openai_chat  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   qwen3.8-flash wrote plans as text in 4 of 12 auto replies here; with
#   LLM_TOOL_CHOICE=required all 12 were tool calls.
#   On qwen-flash, forced propose_plan returned malformed JSON with the full vision
#   context; auto produced valid describe_objects -> speak plans in 3/3 checks.
#   A later auto reply was malformed too; tool selection does not enforce JSON syntax.
#   qwen-flash/json_object also produced a misplaced plan.text field. The verified voice
#   setup now uses qwen3.8-flash with json_schema as shown above; see examples/voice/README.md.
# Google Gemini (OpenAI-compatible endpoint):
#   LLM_PROTOCOL=openai_chat  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter (model IDs look like vendor/model):
#   LLM_PROTOCOL=openai_chat  LLM_BASE_URL=https://openrouter.ai/api/v1
# Local vLLM / Ollama (no key needed on loopback):
#   LLM_PROTOCOL=openai_chat  LLM_BASE_URL=http://127.0.0.1:8000/v1
#   LLM_PROTOCOL=openai_chat  LLM_BASE_URL=http://127.0.0.1:11434/v1

# models/01_plan.py, 02_execute.py and voice/07 call the configured model online when run.
# The CLI still requires --live-model; failures never switch endpoints
# or fall back to a fixed reply.
